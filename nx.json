{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "extends": "nx/presets/npm.json",
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.md)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__mocks__/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.eslintrc.json",
      "{workspaceRoot}/eslint.config.js"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "^api-extractor"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/build", "{projectRoot}/*.tsbuildinfo"],
      "cache": true
    },
    "api-extractor": {
      "dependsOn": ["build"],
      "inputs": ["production", "^production", "{workspaceRoot}/api-extractor.base.json"],
      "outputs": ["{projectRoot}/api-report", "{projectRoot}/temp"],
      "cache": true
    },
    "api-extractor:ci": {
      "dependsOn": ["build"],
      "inputs": ["production", "^production", "{workspaceRoot}/api-extractor.base.json"],
      "outputs": ["{projectRoot}/api-report", "{projectRoot}/temp"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "@nx/js:tsc": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"],
      "cache": true
    },
    "@nx/eslint:lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "@nx/jest:jest": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true,
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{projectRoot}/coverage"]
    }
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "lint",
          "test",
          "type-check",
          "api-extractor",
          "api-extractor:ci"
        ]
      }
    }
  },
  "defaultBase": "main",
  "parallel": 3,
  "cacheDirectory": ".nx/cache",
  "useInferencePlugins": false,
  "nxCloudAccessToken": null,
  "cli": {
    "packageManager": "pnpm"
  }
}
