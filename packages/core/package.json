{
  "name": "@macts/core",
  "version": "0.0.0",
  "description": "Core runtime and manifest parsing for macts - TypeScript SDKs for macOS automation",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/core.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run",
    "lint": "eslint src",
    "test": "vitest run",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.9",
    "js-yaml": "^4.1.1",
    "pluralize": "^8.0.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/pluralize": "^0.0.33",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "tsd": {
    "directory": "src/permissions",
    "testFilePattern": "*.test-d.ts"
  }
}
