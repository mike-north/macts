{
  "name": "@macts/mcp",
  "version": "0.0.0",
  "description": "Model Context Protocol server for macOS app automation",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/mcp.d.ts",
  "bin": {
    "macts-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run"
  },
  "dependencies": {
    "@macts/api": "workspace:*",
    "@macts/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  }
}
