{
  "name": "@macts/mcp",
  "version": "0.4.0",
  "description": "Model Context Protocol server for macOS app automation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/mcp.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run"
  },
  "dependencies": {
    "@macts/contracts": "workspace:*",
    "@macts/core": "workspace:*",
    "@macts/runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
