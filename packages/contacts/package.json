{
  "name": "@macts/contacts",
  "version": "0.3.0",
  "description": "SDK and CLI for macOS contacts automation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/contacts"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/contacts.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/contacts.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "macts-sdk",
    "macts-cli-plugin"
  ],
  "scripts": {
    "build": "tsup",
    "api-extractor": "api-extractor run --local && api-extractor run --local --config api-extractor.contract.json",
    "api-extractor:ci": "api-extractor run && api-extractor run --config api-extractor.contract.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@macts/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@macts/cli": "*",
    "clipanion": "catalog:",
    "typanion": "catalog:"
  },
  "peerDependenciesMeta": {
    "@macts/cli": {
      "optional": true
    },
    "clipanion": {
      "optional": true
    },
    "typanion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@macts/cli": "workspace:*",
    "clipanion": "catalog:",
    "tsup": "catalog:",
    "typanion": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
