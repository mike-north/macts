{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "../../api-extractor.base.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/local.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/api-report",
    "reportFileName": "sdk-local.api.md"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/sdk-local.d.ts"
  }
}
