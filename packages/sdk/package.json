{
  "name": "@macts/sdk",
  "version": "0.2.0",
  "description": "Frictionless authoring helper for governed macts scripts — resolves the API key and base URL once, returns ready-to-use typed clients for every installed @macts/* app SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/sdk.d.ts",
  "files": [
    "dist",
    "AUTHORING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "macts-sdk"
  ],
  "scripts": {
    "build": "tsup",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
