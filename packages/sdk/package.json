{
  "name": "@macts/sdk",
  "version": "0.2.0",
  "description": "Typed, governed clients for macOS apps automated by macts: one client factory for a remote macts service and one for in-process use on the Mac, with the canonical errors and value types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/sdk-local.d.ts",
      "import": "./dist/local.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/sdk.d.ts",
  "files": [
    "dist",
    "AUTHORING.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "macts-sdk"
  ],
  "scripts": {
    "build": "tsup",
    "api-extractor": "api-extractor run --local && api-extractor run --local --config api-extractor.local.json",
    "api-extractor:ci": "api-extractor run && api-extractor run --config api-extractor.local.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit"
  },
  "tsd": {
    "directory": "src",
    "testFilePattern": "**/*.test-d.ts"
  },
  "dependencies": {
    "@macts/contracts": "workspace:*",
    "@macts/core": "workspace:*",
    "@macts/runtime": "workspace:*"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@macts/api": "workspace:*",
    "@macts/calendar": "workspace:*",
    "@macts/contacts": "workspace:*",
    "@macts/music": "workspace:*",
    "@macts/notes": "workspace:*",
    "@macts/reminders": "workspace:*",
    "@macts/tv": "workspace:*",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
