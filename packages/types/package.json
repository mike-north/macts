{
  "name": "@macts/types",
  "version": "0.2.0",
  "description": "Shared, zero-runtime type definitions for the macts ecosystem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/types"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  }
}
