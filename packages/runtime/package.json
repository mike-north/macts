{
  "name": "@macts/runtime",
  "version": "0.2.0",
  "description": "Mac-side runtime shared by macts surfaces: the operation invocation pipeline, API-key verification and storage, and governance loading",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/runtime.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run"
  },
  "tsd": {
    "directory": "src",
    "testFilePattern": "**/*.test-d.ts"
  },
  "dependencies": {
    "@macts/contracts": "workspace:*",
    "@macts/core": "workspace:*",
    "jose": "^5.10.0",
    "pino": "^10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
