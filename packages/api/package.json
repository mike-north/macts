{
  "name": "@macts/api",
  "version": "0.4.0",
  "description": "HTTP API server for macOS app automation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/api.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@macts/contracts": "workspace:*",
    "@macts/core": "workspace:*",
    "@macts/runtime": "workspace:*",
    "hono": "^4.7.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
