{
  "name": "@macts/api",
  "version": "0.1.0",
  "description": "HTTP API server for macOS app automation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/api"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "import": "./dist/keys/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "peerDependencies": {
    "@opentelemetry/sdk-node": ">=0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.50.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-http": {
      "optional": true
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/api.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "api-extractor": "api-extractor run --local",
    "api-extractor:ci": "api-extractor run",
    "lint": "eslint src",
    "test": "vitest run",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@macts/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.7.0",
    "jose": "^5.10.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "tsd": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "tsd": {
    "directory": "src/keys",
    "testFilePattern": "*.test-d.ts"
  }
}
