{
  "name": "@macts/finder-server",
  "version": "0.1.0",
  "description": "Server package for macOS Finder.app (API + MCP)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-north/macts.git",
    "directory": "packages/finder-server"
  },
  "keywords": [
    "macts-server"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/finder-server.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/finder-server.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@macts/api": "workspace:*",
    "@macts/core": "workspace:*",
    "@macts/types": "workspace:*",
    "@macts/finder": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  }
}
