{
  "name": "@macts-e2e/mcp-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "MCP contract-tools integration: serves the real Notes and Calendar contracts through the @macts/mcp adapter, a real runtime, and a real MCP client and server, and checks tool derivation, dispatch, and the structured error shape",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@macts/calendar": "workspace:*",
    "@macts/contracts": "workspace:*",
    "@macts/core": "workspace:*",
    "@macts/mcp": "workspace:*",
    "@macts/notes": "workspace:*",
    "@macts/runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
