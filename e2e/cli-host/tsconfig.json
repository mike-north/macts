{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "composite": false,
    // Required by @modelcontextprotocol/sdk's declarations, an upstream issue:
    // they use DOM fetch types (`HeadersInit`) without declaring them, and
    // `StreamableHTTPClientTransport` does not satisfy its own `Transport`
    // interface under `exactOptionalPropertyTypes`. This package is a private
    // test suite, never published.
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
