{
  "name": "macts-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript SDKs for macOS automation - generate type-safe APIs from AppleScript dictionaries",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.20.0",
    "@microsoft/api-documenter": "^7.26.0",
    "@microsoft/api-extractor": "^7.56.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.2",
    "nx": "^20.6.1",
    "prettier": "^3.5.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.22.1",
    "vitest": "^3.1.0"
  }
}
